# ============================================================================
# crypto-arbitrage-bot — configuration reference
# Copy to .env and adjust.  Every variable uses the CAT_ prefix and __ as the
# nesting delimiter.  Secrets are never logged.
# ============================================================================

# ------------------------------- trading mode -------------------------------
# PAPER : simulated execution against live/simulated order books (default)
# DEMO  : real API calls against the venue's demo/testnet environment
# LIVE  : production trading with real capital — requires ALL of:
#         CAT_TRADING__MODE=LIVE
#         CAT_TRADING__ALLOW_LIVE=true
#         CAT_TRADING__LIVE_CONFIRMATION="I UNDERSTAND THE RISK"
CAT_TRADING__MODE=PAPER
CAT_TRADING__ALLOW_LIVE=false
CAT_TRADING__LIVE_CONFIRMATION=
# LIVE transfer arbitrage additionally needs its own withdrawal opt-in:
CAT_TRADING__ALLOW_LIVE_WITHDRAWALS=false
CAT_TRADING__BASE_CURRENCY=USDT

# ------------------------------- storage ------------------------------------
# SQLite by default; PostgreSQL (postgresql+asyncpg://...) for production.
CAT_DATABASE__URL=sqlite+aiosqlite:///./data/bot.db
CAT_DATABASE__AUTO_CREATE_SCHEMA=true
CAT_DATABASE__TRADE_RETENTION_DAYS=90
CAT_DATABASE__AUDIT_RETENTION_DAYS=90

# ------------------------------- exchanges ----------------------------------
# The bot supports exactly these three venues:
CAT_EXCHANGES__ENABLED=binance,okx,bybit
CAT_EXCHANGES__SIMULATE_IN_PAPER=true
CAT_EXCHANGES__REQUEST_TIMEOUT_SECONDS=10
CAT_EXCHANGES__ORDER_BOOK_DEPTH=25
CAT_EXCHANGES__BREAKER_FAILURE_THRESHOLD=5
CAT_EXCHANGES__BREAKER_COOLDOWN_SECONDS=60

# API credentials (per venue; PASSWORD is the OKX passphrase):
# CAT_KEY_BINANCE_APIKEY=
# CAT_KEY_BINANCE_SECRET=
# CAT_KEY_OKX_APIKEY=
# CAT_KEY_OKX_SECRET=
# CAT_KEY_OKX_PASSWORD=
# CAT_KEY_BYBIT_APIKEY=
# CAT_KEY_BYBIT_SECRET=
# DEMO/testnet keys use the same variables — the mode decides the routing.

# --------------------------------- risk -------------------------------------
# Defaults are conservative paper numbers; calibrate to your capital before
# DEMO/LIVE.  Every limit is fail-closed.
CAT_RISK__MAX_TRADE_SIZE=1000          # quote notional per trade
CAT_RISK__MIN_NET_PROFIT_BPS=10        # minimum net profit in bps
CAT_RISK__MAX_DAILY_LOSS=250           # quote currency; breach engages the kill switch
CAT_RISK__MAX_OPEN_TRANSFERS=3         # simultaneously in-flight transfers
CAT_RISK__MAX_EXCHANGE_EXPOSURE=150000
CAT_RISK__MAX_ASSET_EXPOSURE=750000
CAT_RISK__MAX_SLIPPAGE_BPS=15
CAT_RISK__MAX_DATA_AGE_MS=2500         # never trade on older market data

# ------------------------------ market data ---------------------------------
CAT_MARKET_DATA__STREAMS_ENABLED=true  # WebSocket-first, REST fallback
CAT_MARKET_DATA__STALE_AFTER_MS=2000
CAT_MARKET_DATA__MAX_STREAMS_PER_EXCHANGE=48

# --------------------------- triangular arbitrage ---------------------------
CAT_ARBITRAGE__TRIANGLE_ASSETS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,LINK,AVAX,TRX
CAT_ARBITRAGE__DEFAULT_NOTIONAL_QUOTE=1000
CAT_ARBITRAGE__TRIANGLE_MIN_NET_BPS=5
CAT_ARBITRAGE__TRIANGLE_MAX_LEG_SLIPPAGE_BPS=15
CAT_ARBITRAGE__TRIANGLE_MAX_NOTIONAL_QUOTE=500

# ---------------------------- transfer arbitrage ----------------------------
# Top-50 liquid universe (filtered at runtime to actually listed pairs)
CAT_TRANSFER__ASSETS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,LINK,AVAX,TRX,LTC,DOT,BCH,UNI,ATOM,ETC,XLM,FIL,HBAR,APT,NEAR,ARB,OP,SUI,TAO,RNDR,MATIC,TON,SHIB,PEPE,AAVE,ENA,WIF,FLOKI,BONK,TIA,INJ,IMX,MKR,GRT,STX,FET,AR,SEI,JUP,ONDO,STRK,WLD,PYTH,JTO
CAT_TRANSFER__MIN_NET_PROFIT_BPS=70
CAT_TRANSFER__MIN_NOTIONAL_QUOTE=100
CAT_TRANSFER__MAX_NOTIONAL_QUOTE=500
CAT_TRANSFER__DEPOSIT_TIMEOUT_SECONDS=3600   # MANUAL_REVIEW after this
CAT_TRANSFER__POLL_INTERVAL_SECONDS=30
CAT_TRANSFER__SIMULATED_TRANSFER_SECONDS=30  # PAPER/DEMO blockchain delay

# -------------------------------- execution ---------------------------------
CAT_EXECUTION__LEG_TIMEOUT_SECONDS=10
CAT_EXECUTION__PAPER_MAX_SLIPPAGE_BPS=50
CAT_EXECUTION__MIN_NET_AT_EXECUTE_BPS=0
CAT_EXECUTION__AUTO_INTERVAL_SECONDS=5
CAT_EXECUTION__AUTO_MAX_PER_CYCLE=1
CAT_EXECUTION__AUTO_NOTIONAL_QUOTE=1000

# -------------------------------- telegram ----------------------------------
# Token from @BotFather; empty disables the Telegram interface.
CAT_TELEGRAM__BOT_TOKEN=
# Comma-separated chat ids allowed to command the bot.  EMPTY = every command
# is refused (fail-closed: a public bot must never accept strangers).
CAT_TELEGRAM__ALLOWED_CHAT_IDS=
CAT_TELEGRAM__POLL_TIMEOUT_SECONDS=30

# -------------------------------- logging -----------------------------------
CAT_LOGGING__LEVEL=INFO
CAT_LOGGING__JSON_LOGS=false
